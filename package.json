{
  "name": "masking.cosquin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "github-build": "ng build --configuration production --base-href 'https://villanuevagonzalo.github.io/Masking.Cosquin/'",
    "github-deploy": "npx angular-cli-ghpages --dir=dist/Masking.Cosquin/browser --no-silent",
    "test": "ng test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.1",
    "@angular/compiler": "^20.3.1",
    "@angular/core": "^20.3.1",
    "@angular/forms": "^20.3.1",
    "@angular/platform-browser": "^20.3.1",
    "@angular/router": "^20.3.1",
    "@thatopen/components": "^3.1.3",
    "@thatopen/components-front": "^3.1.7",
    "rxjs": "~7.8.2",
    "stats": "^1.0.0",
    "tslib": "^2.8.1",
    "web-ifc": "^0.0.71"
  },
  "devDependencies": {
    "@angular/build": "^20.3.2",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.3.1",
    "@thatopen/fragments": "^3.1.7",
    "@thatopen/ui": "^2.4.5",
    "@types/jasmine": "~5.1.9",
    "@types/three": "^0.178.1",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "three": "^0.179.1",
    "typescript": "~5.8.3"
  }
